{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "npm run test:domain && npm run test:unit",
    "test:domain": "node --test \"tests/*.test.mjs\"",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "security:check": "node scripts/check-dependency-security.mjs",
    "verify:pages": "node scripts/verify-pages-build.mjs",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@monaco-editor/react": "^4.7.0",
    "crypto-es": "^3.1.3",
    "fflate": "^0.8.3",
    "lucide-react": "^1.47.0",
    "monaco-editor": "^0.57.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "sm-crypto": "^0.5.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.6",
    "gh-pages": "6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "8.2.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "dompurify": "3.4.16",
    "source-map-js": "1.2.2"
  }
}
