{
  "schema_version":"1.1",
  "rules":[
    {"rule_id":"REL-WDG-001","version":"1.0","owner":"reliability","trigger":["watchdog","hang_recovery"],"applies_when":"watchdog/health monitor is designed or tested","required_inputs":["critical cycle/deadline","fault coverage","reset/recovery contract"],"actions":["feed only after critical work completes","inject task/deadlock/resource faults","record reset cause","verify safe restart and recurrence handling"],"required_evidence":["feed-path analysis","fault/reset/recovery log"],"acceptance":["blocked critical work prevents unconditional feed","fault is detected within approved bound","reset preserves safe outputs and diagnosable cause"],"failure_policy":"block reliability claim and retain fault evidence","links":["INT-STATE-001"]},
    {"rule_id":"REL-PWR-001","version":"1.0","owner":"reliability","trigger":["brownout","power_cycle","power_interruption"],"applies_when":"power quality/interruption can affect state","required_inputs":["approved voltage/time profile","critical writes/states","safe outputs"],"actions":["apply min/max/ramp/dip/cycle cases","monitor reset and outputs","verify persistent data and recovery"],"required_evidence":["power waveform","state/data before and after"],"acceptance":["no partially valid persistent record is accepted","output remains/reaches safe state","restart completes or reports recoverable terminal failure"],"failure_policy":"isolate corrupt data and block release","links":["SW-NVM-001"]},
    {"rule_id":"REL-EMC-001","version":"1.0","owner":"reliability","trigger":["ESD","EFT","surge","EMC"],"applies_when":"electromagnetic immunity/emission is evaluated","required_inputs":["applicable standard/test plan","level/setup","operating modes and criteria"],"actions":["lock sample/version/setup","monitor during stress","classify behavior and recovery","perform post-stress checks"],"required_evidence":["lab/precheck report","setup photos/diagram","raw logs"],"acceptance":["applied test matches approved plan","behavior meets stated criterion in every required mode","post-stress safety/data/function checks pass"],"failure_policy":"stop unsafe test isolate sample and open root-cause regression","links":["VER-REAL-001"]},
    {"rule_id":"REL-ENV-001","version":"1.0","owner":"reliability","trigger":["temperature","humidity","vibration","environment"],"applies_when":"environmental range/lifetime is claimed","required_inputs":["approved profile/duration","sample/configuration","functional criteria"],"actions":["condition/monitor samples","exercise worst relevant modes","inspect and function-test after stress"],"required_evidence":["chamber/profile log","sample identities","before/during/after results"],"acceptance":["actual profile stays within declared tolerance","all required functions meet criterion across profile","physical damage/parameter drift is dispositioned"],"failure_policy":"quarantine sample and reject range claim","links":["MFG-BOM-001"]},
    {"rule_id":"REL-ENDUR-001","version":"1.0","owner":"reliability","trigger":["endurance","wear","lifetime"],"applies_when":"finite-cycle component/storage is used","required_inputs":["operation frequency/distribution","temperature/stress","rated endurance","required lifetime/margin"],"actions":["calculate worst-case cycles/stress","apply wear-leveling/derating where needed","accelerate-test with justified model"],"required_evidence":["lifetime calculation","rating source","test/model limits"],"acceptance":["calculated usage plus required margin remains within applicable rating","model assumptions are explicit","missing frequency/stress yields UNKNOWN"],"failure_policy":"block lifetime claim and reduce/measure usage","links":["SW-NVM-001"]},
    {"rule_id":"REL-SOAK-001","version":"1.0","owner":"reliability","trigger":["soak","stress_test","long_run"],"applies_when":"stability over time/load is evaluated","required_inputs":["duration/load profile","resource/temperature metrics","limits and stop criteria"],"actions":["record periodic quantitative metrics","rotate bounded logs","inject planned disturbances","analyze trend and failures"],"required_evidence":["time series","fault list","final resource comparison"],"acceptance":["no unbounded growth or limit breach","all planned disturbances recover","test completes declared duration without hidden restart"],"failure_policy":"FAIL at first contract breach and preserve preceding window","links":["OPS-LIMIT-001"]}
  ]
}
