{
  "schema_version": "1.1",
  "rules": [
    {"rule_id":"MFG-BOM-001","version":"1.0","owner":"manufacturing","trigger":["BOM","AVL","substitute_part"],"applies_when":"manufacturing material identity changes","required_inputs":["hardware revision","manufacturer and internal part numbers","approved vendors","substitution conditions"],"actions":["verify exact part/package/spec/lifecycle","compare substitute electrical software calibration regulatory impact","update revision and compatibility"],"required_evidence":["versioned BOM","approval and comparison"],"acceptance":["each fitted reference resolves to one approved orderable part","substitute is verified across all affected constraints","mixed unapproved BOM revision is rejected"],"failure_policy":"hold purchasing/build for unresolved item","links":["MFG-001"]},
    {"rule_id":"MFG-DFT-001","version":"1.0","owner":"manufacturing","trigger":["DFM","DFA","DFT"],"applies_when":"design is prepared for manufacture/test","required_inputs":["fabricator/assembler capabilities","test coverage targets","repair strategy"],"actions":["check manufacturability assembly access polarity and inspection","map required nets/functions to test access","identify untestable risks"],"required_evidence":["DFM/DFA report","test-point coverage map"],"acceptance":["every mandatory production check has accessible method","critical polarity/orientation is inspectable","capability exceptions have approved disposition"],"failure_policy":"block manufacturing readiness claim","links":["PCB-004"]},
    {"rule_id":"MFG-FIX-001","version":"1.0","owner":"manufacturing","trigger":["fixture","production_test"],"applies_when":"a product is connected to automated production equipment","required_inputs":["fixture hardware/software version","DUT identity","safe operating limits","self-test"],"actions":["verify fixture identity and calibration","run self-test","validate target and connections before stimulus","enforce timeout emergency stop and release"],"required_evidence":["fixture self-test","DUT/fixture version log","raw production result"],"acceptance":["wrong DUT/fixture combination is rejected","stimulus never exceeds verified limit","failure/cancel releases DUT and fixture safely"],"failure_policy":"isolate station and affected units","links":["TEST-001"]},
    {"rule_id":"MFG-CAL-001","version":"1.0","owner":"manufacturing","trigger":["calibration"],"applies_when":"unit-specific measurement coefficients are produced","required_inputs":["traceable reference","environment","algorithm/range","schema and product identity"],"actions":["record raw reference and DUT readings","calculate coefficients deterministically","validate range","write then read back versioned record"],"required_evidence":["raw readings","calculation","write/readback log","reference calibration"],"acceptance":["coefficient derives from recorded current measurements","coefficient and residual error meet project limits","stored version length checksum and identity read back exactly"],"failure_policy":"reject/segregate unit; never insert guessed default production value","links":["MFG-002"]},
    {"rule_id":"MFG-TRACE-001","version":"1.1","owner":"manufacturing","trigger":["production","release_unit"],"applies_when":"a unit or batch is accepted","required_inputs":["unit/batch identity","hardware/BOM/firmware/boot/calibration/test versions"],"actions":["bind complete version tuple","link raw test/calibration results","verify uniqueness and retention"],"required_evidence":["trace record","compatibility result","approval source"],"acceptance":["every accepted identity has complete compatible tuple","duplicate/missing identity is rejected","record links to immutable raw results"],"failure_policy":"quarantine affected unit/batch","links":["MFG-001","MFG-002"]},
    {"rule_id":"MFG-REL-001","version":"1.0","owner":"manufacturing","trigger":["mass_production_release"],"applies_when":"production configuration is promoted","required_inputs":["approved design/manufacturing baselines","yield/defect status","open deviations","responsible approval"],"actions":["verify all baseline hashes","check deviations/CAPA and compatibility","require external approval"],"required_evidence":["release checklist","baseline manifest","approval identity"],"acceptance":["no blocking defect/deviation remains","all production files share one approved revision tuple","approval is externally verifiable"],"failure_policy":"remain candidate; AI cannot self-release","links":["PACK-003"]}
  ]
}
