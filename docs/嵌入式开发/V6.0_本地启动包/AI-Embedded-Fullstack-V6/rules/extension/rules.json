{
  "schema_version":"1.1",
  "rules":[
    {"rule_id":"EXT-MAN-001","version":"1.0","owner":"extension","trigger":["new_adapter","plugin"],"applies_when":"an extension is registered","required_inputs":["stable ID/version/provider","capabilities/applicability","permissions/dependencies/resources","schemas/tests"],"actions":["validate manifest","reject duplicate/incompatible registration","index declared capabilities"],"required_evidence":["manifest","schema validation","compatibility declaration"],"acceptance":["all mandatory manifest fields exist","capabilities and version ranges are explicit","no project-specific path/value becomes universal default"],"failure_policy":"do not register extension","links":["PACK-002"]},
    {"rule_id":"EXT-API-001","version":"1.0","owner":"extension","trigger":["adapter_implementation"],"applies_when":"extension invokes a tool/device/parser","required_inputs":["adapter contract","typed actions","evidence/output schema"],"actions":["implement probe/supports/plan/execute/evidence/verify/rollback","separate dry plan from execute","return structured error/status"],"required_evidence":["contract tests","probe and execution logs"],"acceptance":["probe/plan have no prohibited side effect","execute rejects untyped/unauthorized action","success requires output verification"],"failure_policy":"disable adapter and preserve core operation","links":["CORE-021"]},
    {"rule_id":"EXT-ISO-001","version":"1.0","owner":"extension","trigger":["plugin_execute"],"applies_when":"third-party extension can consume resources or mutate state","required_inputs":["permission/capability set","path/network/device scope","time/memory/output limits"],"actions":["apply least capability","enforce limits/cancel","isolate failure","release resources"],"required_evidence":["negative permission tests","timeout/cancel/resource result"],"acceptance":["extension cannot access undeclared target through supported path","timeout/cancel terminates and releases resources","one extension failure leaves core/others usable"],"failure_policy":"quarantine extension and report POLICY_ONLY if host mediation incomplete","links":["CORE-025"]},
    {"rule_id":"EXT-COMP-001","version":"1.0","owner":"extension","trigger":["extension_upgrade","schema_change"],"applies_when":"extension/API/data version changes","required_inputs":["old/new versions","compatibility matrix","migration/rollback"],"actions":["test compatible ranges","migrate copy not original","verify and switch","retain rollback"],"required_evidence":["compatibility tests","migration diff/result"],"acceptance":["supported old data reads without loss","unsupported version is explicit not misparsed","failed migration preserves original"],"failure_policy":"use prior compatible extension or generic fallback","links":["CORE-028"]},
    {"rule_id":"EXT-PARSE-001","version":"1.0","owner":"extension","trigger":["parser","analysis_rule"],"applies_when":"extension converts external format into facts","required_inputs":["format/version/signature","limits","unknown-field policy","samples"],"actions":["validate signature/version/size","parse bounded input","retain offsets/raw evidence","report coverage/unknown/confidence"],"required_evidence":["normal/corrupt/unknown/boundary tests","source offsets"],"acceptance":["malformed input cannot crash/hang or escape limits","unknown format is not labeled known","each conclusion links raw position and deterministic rule"],"failure_policy":"preserve raw data and downgrade to generic analysis","links":["CORE-009"]},
    {"rule_id":"EXT-REL-001","version":"1.0","owner":"extension","trigger":["extension_release"],"applies_when":"extension is distributed/enabled","required_inputs":["source/binary provenance","license/dependencies","manifest/tests/compatibility"],"actions":["run full extension matrix","scan/package","hash deliverables","document safe degradation"],"required_evidence":["test report","provenance/license","package manifest"],"acceptance":["all mandatory normal/negative/compatibility tests pass","dependencies and license are declared","safe degradation works when capability missing"],"failure_policy":"do not release/enable by default","links":["REL-PACK-001"]}
  ]
}
