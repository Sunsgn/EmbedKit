{
  "schema_version":"1.1",
  "rules":[
    {"rule_id":"MEC-IF-001","version":"1.0","owner":"mechanical_thermal","trigger":["enclosure","mechanical_interface"],"applies_when":"PCB/components mate with mechanical parts","required_inputs":["common datum/unit","board/mechanical revisions","critical features"],"actions":["compare outline holes connectors keepouts heights and openings","verify coordinate conversion","run collision/access check"],"required_evidence":["interface drawing/model","difference/collision report"],"acceptance":["all critical features use same datum/unit/revision","no unresolved collision/keepout violation","connect/operate/service access is verified"],"failure_policy":"block affected layout/enclosure release","links":["PCB-IN-001"]},
    {"rule_id":"MEC-TOL-001","version":"1.0","owner":"mechanical_thermal","trigger":["tolerance","fit"],"applies_when":"multiple dimensions determine assembly/clearance","required_inputs":["dimension chain","manufacturing tolerances","required clearance/compression"],"actions":["calculate worst-case stack","identify dominant contributors","validate with representative parts"],"required_evidence":["tolerance table/calculation","fit result"],"acceptance":["worst-case stack meets required clearance/compression","no tolerance is guessed","critical fit has physical or approved process validation"],"failure_policy":"reject nominal-only fit claim","links":["MFG-DFT-001"]},
    {"rule_id":"MEC-THERM-001","version":"1.0","owner":"mechanical_thermal","trigger":["thermal","temperature_rise"],"applies_when":"component/product temperature is evaluated","required_inputs":["losses","ambient/range","materials/contact/boundaries","component limits"],"actions":["model all significant heat sources/paths","calculate/simulate worst modes","measure prototype at defined points","correlate model"],"required_evidence":["model assumptions","thermal result","measurement/calibration"],"acceptance":["measured worst required mode remains within derated project limit","model discrepancy is explained","missing heat source/boundary makes conclusion UNKNOWN"],"failure_policy":"block thermal/rating claim and define mitigation/retest","links":["HW-PWR-001"]},
    {"rule_id":"MEC-MAT-001","version":"1.0","owner":"mechanical_thermal","trigger":["material","coating","adhesive"],"applies_when":"material affects environment safety or lifetime","required_inputs":["exact material/grade","environment","process","regulatory requirements"],"actions":["verify temperature chemical UV moisture flammability and compatibility","assess aging/rework/substitute","record supplier data"],"required_evidence":["material datasheet/certification","compatibility decision"],"acceptance":["material identity and applicable ratings are traceable","operating/process range fits project profile","substitute is not assumed equivalent"],"failure_policy":"block material approval","links":["REL-ENV-001"]},
    {"rule_id":"MEC-SEAL-001","version":"1.0","owner":"mechanical_thermal","trigger":["IP_rating","seal"],"applies_when":"ingress protection is required","required_inputs":["target rating/standard","seals/interfaces","pressure/vent/environment"],"actions":["analyze every ingress path","calculate/verify seal compression","test assembled representative unit","inspect after test"],"required_evidence":["seal design","test setup/result","unit identity"],"acceptance":["actual test matches required rating method","all openings/interfaces are covered","post-test internal/function criteria pass"],"failure_policy":"do not claim IP level; redesign and retest","links":["REL-ENV-001"]},
    {"rule_id":"MEC-ASM-001","version":"1.0","owner":"mechanical_thermal","trigger":["assembly","fastener","wire_harness"],"applies_when":"product is assembled or serviced","required_inputs":["assembly order","fastener/process specs","access and inspection"],"actions":["verify sequence/orientation/poka-yoke","define sourced torque/lock/adhesive controls","check harness strain/bend/clearance","perform assembly/rework trial"],"required_evidence":["work instruction","trial/inspection result"],"acceptance":["assembly cannot damage or misconnect part under defined process","critical process value has source/validation","required inspection and service are accessible"],"failure_policy":"block work instruction/release and preserve trial finding","links":["MFG-DFT-001"]}
  ]
}
